%% coeff_matrix_3d
%{
takes inputs of: dp (dist to next link CoM), dm (dist to prev link CoM), N
(link number), masses (link masses), R (rot matrix), J (moi tensor)
outputs: C, matrix of coefficients to be used in solving for state vector
author: Selen Serdar, last updated: 4/5/2026
%}

function C = coeff_matrix_3d_4(dp, dm, N, masses, Rlist, Jlist, omegas, phi)

c = zeros(6*N, 1);

for i = 1:3:3*N - 3
    mass = masses(i); 
    R = Rlist(:,:,i);
    nextR = Rlist(:,:,i+1);
    J = Jlist(:,:,i);
    omega = omegas(:, i); % get current link omega vector
    next_omega = omegas(:, i+1); % next

    %   eqn 26 RHS
    c(i:i+2) = c(i:i+2) + R' * cross(omega, cross(omega, dp)) - nextR' * cross(next_omega, cross(next_omega, dm)); 
    
    % eqn 28
    c()
end

C = sparse(c);
end